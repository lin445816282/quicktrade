/** éšç§/æ¡æ¬¾æ®µè½ç»„ä»¶ */
@Component
struct PolicyItem {
  @Prop title: string = ''
  @Prop content: string = ''

  build() {
    Column() {
      Text(this.title)
        .fontSize(14)
        .fontWeight(FontWeight.Medium)
        .fontColor('#333')
        .width('100%')
        .margin({ bottom: 6 })

      Text(this.content)
        .fontSize(13)
        .fontColor('#666')
        .lineHeight(20)
        .width('100%')
    }
    .width('100%')
    .alignItems(HorizontalAlign.Start)
    .margin({ bottom: 16 })
  }
}
