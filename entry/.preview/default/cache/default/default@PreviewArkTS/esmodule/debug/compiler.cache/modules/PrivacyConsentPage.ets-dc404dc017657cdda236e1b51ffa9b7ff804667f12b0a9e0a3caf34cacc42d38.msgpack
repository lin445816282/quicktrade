              const want: Want = {
                action: 'ohos.want.action.viewData',
                entities: ['entity.system.browsable'],
                uri: 'https://www.ct256.cn/privacy-quicktrade'
              }
              ctx.startAbility(want).catch((err: Error) => {
                console.error('Open browser failed:', JSON.stringify(err))
              })
            })
        }
        .width('100%')
        .padding({ left: 4, right: 4 })
      }
      .layoutWeight(1)
      .scrollBar(BarState.Off)

      // åº•éƒ¨æŒ‰é’®
      Column() {
        Button('åŒæ„å¹¶ç»§ç»­')
          .width('100%')
          .height(48)
          .fontSize(16)
          .fontWeight(FontWeight.Medium)
          .backgroundColor('#2d6be0')
          .fontColor('#fff')
          .borderRadius(24)
          .onClick(() => this.agree())

        Button('ä¸åŒæ„å¹¶é€€å‡º')
          .width('100%')
          .height(48)
          .fontSize(15)
          .fontWeight(FontWeight.Normal)
          .backgroundColor(Color.Transparent)
          .fontColor('#999')
          .margin({ top: 12 })
          .onClick(() => this.disagree())
      }
      .width('100%')
      .padding({ left: 28, right: 28, bottom: 36 })
    }
    .width('100%')
    .height('100%')
    .backgroundColor('#f8f9fc')
  }
}

@Component
struct PrivacyItem {
  @Prop icon: string = ''
  @Prop label: string = ''
  @Prop desc: string = ''

  build() {
    Row() {
      Text(this.icon)
        .fontSize(18)
        .margin({ right: 10 })

      Column() {
        Text(this.label)
          .fontSize(14)
          .fontWeight(FontWeight.Medium)
          .fontColor('#333')
        Text(this.desc)
          .fontSize(12)
          .fontColor('#999')
          .margin({ top: 2 })
      }
      .alignItems(HorizontalAlign.Start)
    }
    .width('100%')
    .padding({ top: 12, bottom: 12 })
    .alignItems(VerticalAlign.Top)
  }
}
