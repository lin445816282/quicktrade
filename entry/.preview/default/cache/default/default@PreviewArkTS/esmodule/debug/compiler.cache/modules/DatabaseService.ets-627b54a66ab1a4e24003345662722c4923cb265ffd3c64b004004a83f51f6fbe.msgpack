async function seedDefaultCategories(store) {
    try {
        const check = await store.querySql('SELECT COUNT(*) as cnt FROM categories', []);
        check.goToFirstRow();
        if (check.getLong(check.getColumnIndex('cnt')) > 0) {
            check.close();
            return;
        }
        check.close();
        const defaults = [
            ['é¤é¥®', 'ğŸœ', 'expense', 1],
            ['äº¤é€š', 'ğŸš—', 'expense', 2],
            ['è´­ç‰©', 'ğŸ›ï¸', 'expense', 3],
            ['æ—¥ç”¨å“', 'ğŸ§´', 'expense', 4],
            ['å¨±ä¹', 'ğŸ®', 'expense', 5],
            ['é€šè®¯', 'ğŸ“±', 'expense', 6],
            ['å±…ä½', 'ğŸ ', 'expense', 7],
            ['åŒ»ç–—', 'ğŸ’Š', 'expense', 8],
            ['æ•™è‚²', 'ğŸ“š', 'expense', 9],
            ['å·¥èµ„', 'ğŸ’µ', 'income', 1],
            ['æŠ•èµ„', 'ğŸ“ˆ', 'income', 2],
            ['å…¼èŒ', 'ğŸ’¼', 'income', 3],
            ['é€€æ¬¾', 'â†©ï¸', 'income', 4],
            ['å…¶ä»–', 'ğŸ“Œ', 'expense', 99],
            ['å…¶ä»–', 'ğŸ“Œ', 'income', 99]
        ];
        for (let i = 0; i < defaults.length; i++) {
            const vb = {
                'name': defaults[i][0],
                'icon': defaults[i][1],
                'type': defaults[i][2],
                'sort_order': defaults[i][3],
                'user_id': 0
            };
            await store.insert('categories', vb);
        }
        hilog.info(0x0000, 'QuickTrade', `seedDefaultCategories: ${defaults.length} rows`);
    }
    catch (e) {
        hilog.error(0x0000, 'QuickTrade', `seedDefaultCategories failed: ${JSON.stringify(e)}`);
    }
}
function buildCategory(id, name, icon, type, sortOrder) {
    const c = new Category();
    c.id = id;
    c.name = name;
    c.icon = icon;
    c.type = type;
    c.sort_order = sortOrder;
    return c;
}
function buildTransaction(id, txType, amount, category, note, createdAt) {
    const t = new Transaction();
    t.id = id;
    t.type = txType;
    t.amount = amount;
    t.category = category;
    t.note = note;
    t.created_at = createdAt;
    return t;
}
export class DatabaseService {
    /** ---------- äº¤æ˜“ CRUD ---------- */
    static async insert(tx) {
        const store = await getStore();
        const vb = {
            'type': tx.type,
            'amount': tx.amount,
            'category': tx.category,
            'note': tx.note,
            'created_at': tx.created_at || localISO(),
            'user_id': AuthService.getCurrentUserId()
        };
        return await store.insert('transactions', vb);
    }
    static async delete(id) {
        const store = await getStore();
        const uid = AuthService.getCurrentUserId();
        await store.executeSql('DELETE FROM transactions WHERE id = ? AND user_id = ?', [id, uid]);
        return 1;
    }
    static async update(tx) {
        const store = await getStore();
        const uid = AuthService.getCurrentUserId();
        const vb = {
            'type': tx.type,
            'amount': tx.amount,
            'category': tx.category,
            'note': tx.note
        };
        const predicates = new relationalStore.RdbPredicates('transactions');
        predicates.equalTo('id', tx.id);
        predicates.equalTo('user_id', uid);
        return await store.update(vb, predicates);
    }
    static async getAll(total = 500) {
        const store = await getStore();
        const uid = AuthService.getCurrentUserId();
        const resultSet = await store.querySql('SELECT * FROM transactions WHERE user_id = ? ORDER BY created_at DESC LIMIT ?', [uid, total]);
        return DatabaseService.resultToTransactions(resultSet);
