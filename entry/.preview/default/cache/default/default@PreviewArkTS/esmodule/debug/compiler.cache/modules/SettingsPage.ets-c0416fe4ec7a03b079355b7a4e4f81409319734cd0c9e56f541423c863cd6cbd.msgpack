      primaryButton: { value: 'å–æ¶ˆ', action: () => {} },
      secondaryButton: { value: 'åˆ é™¤', fontColor: '#e74c3c', action: () => { this.doDelete(cat) } }
    })
  }
  async doDelete(cat: Category) {
    try { await DatabaseService.deleteCategory(cat.id); promptAction.showToast({ message: `å·²åˆ é™¤ã€Œ${cat.name}ã€`, duration: 1500 }); this.loadData() }
    catch (e) { promptAction.showToast({ message: 'åˆ é™¤å¤±è´¥', duration: 1500 }) }
  }

  openEdit(cat: Category) { this.editingCategory = cat; this.editName = cat.name; this.editIcon = cat.icon; this.showEditIconPicker = false; this.showEditDialog = true }
  async saveEdit() {
    if (!this.editingCategory) return
    if (!this.editName.trim()) { promptAction.showToast({ message: 'è¯·è¾“å…¥ç±»åˆ«åç§°', duration: 1500 }); return }
    try { await DatabaseService.updateCategory(this.editingCategory.id, this.editName.trim(), this.editIcon || 'ğŸ’°'); promptAction.showToast({ message: 'ä¿®æ”¹æˆåŠŸ', duration: 1500 }); this.showEditDialog = false; this.loadData() }
    catch (e) { promptAction.showToast({ message: 'ä¿®æ”¹å¤±è´¥', duration: 1500 }) }
  }

  async addCategory() {
    if (!this.newName.trim()) { promptAction.showToast({ message: 'è¯·è¾“å…¥ç±»åˆ«åç§°', duration: 1500 }); return }
    try { await DatabaseService.addCategory(this.newName.trim(), this.newIcon || 'ğŸ’°', this.newType as TransactionType); promptAction.showToast({ message: 'æ·»åŠ æˆåŠŸ', duration: 1500 }); this.showAddDialog = false; this.newName = ''; this.newIcon = 'ğŸ’°'; this.loadData() }
    catch (e) { promptAction.showToast({ message: 'æ·»åŠ å¤±è´¥', duration: 1500 }) }
  }

  async exportAndShare() {
    this.exporting = true
    try {
      const ctx = getContext(this) as common.UIAbilityContext
      const path = await ExportService.exportAll(ctx)
      const shared = await ExportService.shareFile(path, ctx)
      if (shared) { promptAction.showToast({ message: 'å·²åˆ†äº«', duration: 1500 }) }
      else { await ExportService.copyToClipboard(path); promptAction.showToast({ message: 'å·²å¯¼å‡ºå¹¶å¤åˆ¶åˆ°å‰ªè´´æ¿', duration: 2000 }) }
      this.loadData()
    } catch (e) { promptAction.showToast({ message: 'å¯¼å‡ºå¤±è´¥', duration: 1500 }) }
    finally { this.exporting = false }
  }

  async shareFileItem(path: string) {
    try {
      const ctx = getContext(this) as common.UIAbilityContext
      const shared = await ExportService.shareFile(path, ctx)
      if (!shared) { await ExportService.copyToClipboard(path); promptAction.showToast({ message: 'å·²å¤åˆ¶åˆ°å‰ªè´´æ¿', duration: 1500 }) }
    } catch (e) { promptAction.showToast({ message: 'åˆ†äº«å¤±è´¥', duration: 1500 }) }
  }

  async copyFile(path: string) {
    try { await ExportService.copyToClipboard(path); promptAction.showToast({ message: 'å·²å¤åˆ¶åˆ°å‰ªè´´æ¿', duration: 1500 }) }
    catch (e) { promptAction.showToast({ message: 'å¤åˆ¶å¤±è´¥', duration: 1500 }) }
  }

  deleteExportFile(path: string) {
    const name = path.slice(path.lastIndexOf('/') + 1)
