}

class ExportFile {
  path: string = ''
  name: string = ''
}

@Entry
@Component
struct SettingsPage {
  @State categories: Category[] = []
  @State loading: boolean = true
  @State showAddDialog: boolean = false
  @State showEditDialog: boolean = false
