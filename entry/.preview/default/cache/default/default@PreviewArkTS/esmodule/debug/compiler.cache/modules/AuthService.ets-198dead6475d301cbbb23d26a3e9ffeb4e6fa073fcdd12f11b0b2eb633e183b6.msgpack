      let accounts: AppAccountInfo[] = []
      try {
        // getAllAccounts å¯èƒ½å› æƒé™/é…ç½®é—®é¢˜å¤±è´¥ï¼Œæ•è·åç»™å‹å¥½æç¤º
        accounts = await accountMgr.getAllAccounts(HUAWEI_ACCOUNT_TYPE) as AppAccountInfo[]
      } catch (e) {
