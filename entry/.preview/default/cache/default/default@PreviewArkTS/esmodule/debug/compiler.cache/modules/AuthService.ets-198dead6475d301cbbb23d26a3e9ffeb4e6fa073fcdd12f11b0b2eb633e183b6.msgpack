        throw new Error('è·å–åä¸ºå¸å·å¤±è´¥ï¼Œè¯·ä½¿ç”¨å¯†ç ç™»å½•')
      }
      if (accounts.length === 0) {
        throw new Error('æœªæ‰¾åˆ°åä¸ºå¸å·ï¼Œè¯·å…ˆåœ¨ç³»ç»Ÿè®¾ç½®ä¸­ç™»å½•åä¸ºå¸å·æˆ–ä½¿ç”¨å¯†ç ç™»å½•')
      }
