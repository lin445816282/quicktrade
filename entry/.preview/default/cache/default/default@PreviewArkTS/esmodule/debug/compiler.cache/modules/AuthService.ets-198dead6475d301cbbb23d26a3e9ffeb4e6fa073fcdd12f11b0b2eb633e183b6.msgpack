        ) as string
        huaweiUid = tokenValue
      } catch (e) {
        hilog.error(0x0000, 'AuthService', `getOAuthToken failed: ${JSON.stringify(e)}`)
        throw new Error('åä¸ºå¸å·æˆæƒå¤±è´¥ï¼Œè¯·åœ¨AGCä¸­é…ç½®Account Kitæˆ–ä½¿ç”¨å¯†ç ç™»å½•')
      }
