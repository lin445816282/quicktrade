     1|/**
     2| * 首页 — 交易列表 + 语音记账入口
     3| * 未登录（游客）可查看功能，但点击+号弹出登录
     4| */
     5|import { Transaction, TransactionType } from '../model/Transaction'
     6|import { DatabaseService } from '../service/DatabaseService'
     7|import { DateUtils } from '../common/utils/DateUtils'
     8|import { NumberUtils } from '../common/utils/NumberUtils'
     9|import router from '@ohos.router'
    10|
    11|import { AuthService } from '../service/AuthService'
    12|
    13|interface TransactionGroup {
    14|  label: string
    15|  items: Transaction[]
    16|}
    17|
    18|@Entry
    19|@Component
    20|struct Index {
    21|  @State transactions: Transaction[] = []
    22|  @State todayIncome: number = 0
    23|  @State todayExpense: number = 0
    24|  @State groups: TransactionGroup[] = []
    25|  @State loading: boolean = true
    26|  @State showLoginDialog: boolean = false
    27|  @State loginUsername: string = ''
    28|  @State loginPassword: string = ''
    29|  @State loginLoading: boolean = false
    30|  @State loginIsRegister: boolean = false
    31|  @State loginError: string = ''
    32|  @State loginAgreed: boolean = false
    33|  @State showPrivacyContent: string = ''
    34|
    35|  aboutToAppear() {
    36|    this.loadData()
    37|  }
    38|
    39|  onPageShow() {
    40|    this.loadData()
    41|  }
    42|
    43|  /** 加载数据 */
    44|  async loadData() {
    45|    this.loading = true
    46|    try {
    47|      const txs = await DatabaseService.getAll()
    48|      this.transactions = txs
    49|      this.groups = this.groupByDate(txs)
    50|
    51|      const summary = await DatabaseService.getTodaySummary()
    52|      this.todayIncome = summary.income
    53|      this.todayExpense = summary.expense
    54|    } catch (e) {
    55|      console.error('Index loadData failed:', JSON.stringify(e))
    56|    }
    57|    this.loading = false
    58|  }
    59|
    60|  /** 按日期分组 */
    61|  groupByDate(list: Transaction[]): TransactionGroup[] {
    62|    const map = new Map<string, Transaction[]>()
    63|    for (const item of list) {
    64|      const label = DateUtils.formatGroupLabel(item.created_at)
    65|      if (!map.has(label)) map.set(label, [])
    66|      map.get(label)!.push(item)
    67|    }
    68|    const result: TransactionGroup[] = []
    69|    map.forEach((items, label) => result.push({ label, items }))
    70|    return result
    71|  }
    72|
    73|  /** 跳转手动记账 — 未登录弹窗 */
    74|  goToRecord() {
    75|    if (!AuthService.isLoggedIn()) {
    76|      this.showLoginDialog = true
    77|      return
    78|    }
    79|    router.pushUrl({ url: 'pages/RecordPage' })
    80|  }
    81|
    82|  /** 跳转统计 */
    83|  goToStats() {
    84|    router.pushUrl({ url: 'pages/StatsPage' })
    85|  }
    86|
    87|  /** 删除交易 */
    88|  async deleteTransaction(id: number) {
    89|    await DatabaseService.delete(id)
    90|    this.loadData()
    91|  }
    92|
    93|  /** 今日净额 */
    94|  get netAmount(): string {
    95|    const net = this.todayIncome - this.todayExpense
    96|    return NumberUtils.formatMoney(net)
    97|  }
    98|
    99|  /** 登出 — 变回游客模式 */
   100|  logout() {
   101|    AuthService.logout()
   102|    this.showLoginDialog = false
   103|    this.loadData()
   104|  }
   105|
   106|  /** 登录弹窗提交 */
   107|  async doLogin() {
   108|    if (!this.loginAgreed) {
   109|      this.loginError = '请先阅读并同意隐私政策和用户条款'
   110|      return
   111|    }
   112|    const u = this.loginUsername.trim()
   113|    const p = this.loginPassword.trim()
   114|    if (!u || !p) {
   115|      this.loginError = '请输入用户名和密码'
   116|      return
   117|    }
   118|    this.loginLoading = true
   119|    this.loginError = ''
   120|    try {
   121|      if (this.loginIsRegister) {
   122|        await AuthService.register(u, p)
   123|      } else {
   124|        await AuthService.login(u, p)
   125|      }
   126|      this.showLoginDialog = false
   127|      this.loginUsername = ''
   128|      this.loginPassword = ''
   129|      this.loginIsRegister = false
   130|      this.loginAgreed = false
   131|      this.loadData()
   132|    } catch (e) {
   133|      this.loginError = e instanceof Error ? e.message : '操作失败'
   134|    }
   135|    this.loginLoading = false
   136|  }
   137|
   138|  /** 华为帐号一键登录 */
   139|  async doHuaweiLogin() {
   140|    if (!this.loginAgreed) {
   141|      this.loginError = '请先阅读并同意隐私政策和用户条款'
   142|      return
   143|    }
   144|    try {
   145|      await AuthService.huaweiLogin()
   146|      this.showLoginDialog = false
   147|      this.loginAgreed = false
   148|      this.loadData()
   149|    } catch (e) {
   150|      this.loginError = e instanceof Error ? e.message : '登录失败'
   151|    }
   152|  }
   153|
   154|  /** 取消登录弹窗，继续游客浏览 */
   155|  cancelLogin() {
   156|    this.showLoginDialog = false
   157|    this.loginUsername = ''
   158|    this.loginPassword = ''
   159|    this.loginError = ''
   160|    this.loginAgreed = false
   161|  }
   162|
   163|  /** 切换隐私协议勾选 */
   164|  toggleAgreed() {
   165|    this.loginAgreed = !this.loginAgreed
   166|  }
   167|
   168|  build() {
   169|    Stack() {
   170|      Column() {
   171|        // === 顶部栏 ===
   172|        Row() {
   173|          if (AuthService.isLoggedIn()) {
   174|            Text(`👤 ${AuthService.getCurrentUsername()}`).fontSize(13).fontColor('#666').layoutWeight(1)
   175|            Text('退出').fontSize(13).fontColor('#e74c3c').onClick(() => this.logout())
   176|          } else {
   177|            Text('👤 游客').fontSize(13).fontColor('#999').layoutWeight(1)
   178|            Text('登录').fontSize(13).fontColor('#27ae60').fontWeight(FontWeight.Medium)
   179|              .onClick(() => { this.showLoginDialog = true })
   180|          }
   181|        }
   182|        .width('100%')
   183|        .padding({ left: 16, right: 16, top: 8, bottom: 8 })
   184|        .backgroundColor('#fff')
   185|        .border({ width: { bottom: 0.5 }, color: '#f0f0f0' })
   186|
   187|        // === 顶部概览卡片 ===
   188|        Row() {
   189|          Column() { Text('今日支出').fontSize(12).fontColor('#999')
   190|            Text(NumberUtils.formatMoney(this.todayExpense))
   191|              .fontSize(22).fontWeight(FontWeight.Bold).fontColor('#e74c3c')
   192|          }
   193|          Column() { Text('今日收入').fontSize(12).fontColor('#999')
   194|            Text(NumberUtils.formatMoney(this.todayIncome))
   195|              .fontSize(22).fontWeight(FontWeight.Bold).fontColor('#27ae60')
   196|          }
   197|          Column() { Text('今日净额').fontSize(12).fontColor('#999')
   198|            Text(this.netAmount)
   199|              .fontSize(22).fontWeight(FontWeight.Bold).fontColor('#333')
   200|          }
   201|        }
   202|        .width('100%')
   203|        .justifyContent(FlexAlign.SpaceAround)
   204|        .padding({ top: 16, bottom: 16 })
   205|        .backgroundColor('#fff')
   206|        .borderRadius(12)
   207|        .margin({ left: 16, right: 16, top: 8 })
   208|
   209|        // === 语音按钮 ===
   210|        Row() {
   211|          Text('🎤 按住说话记账')
   212|            .fontSize(16).fontColor('#ccc')
   213|        }
   214|        .width('90%')
   215|        .height(48)
   216|        .justifyContent(FlexAlign.Center)
   217|        .backgroundColor('#f5f5f5')
   218|        .borderRadius(24)
   219|        .margin({ top: 16, bottom: 8 })
   220|
   221|        // === 交易列表 ===
   222|        if (this.loading) {
   223|          LoadingProgress().margin({ top: 60 })
   224|        } else if (this.groups.length === 0) {
   225|          Column() {
   226|            Text('📝').fontSize(48).margin({ bottom: 12 })
   227|            Text('还没有记录').fontSize(16).fontColor('#999')
   228|            Text('点击下方 + 号开始记账').fontSize(14).fontColor('#ccc').margin({ top: 4 })
   229|          }
   230|          .width('100%')
   231|          .margin({ top: 60 })
   232|        } else {
   233|          List() {
   234|            ForEach(this.groups, (group: TransactionGroup) => {
   235|              ListItem() {
   236|                Column() {
   237|                  Text(group.label)
   238|                    .fontSize(13)
   239|                    .fontColor('#999')
   240|                    .padding({ left: 16, top: 12, bottom: 4 })
   241|                    .width('100%')
   242|
   243|                  ForEach(group.items, (item: Transaction) => {
   244|                    ListItem() {
   245|                      this.TransactionItem(item)
   246|                    }
   247|                  })
   248|                }
   249|              }
   250|            })
   251|          }
   252|          .layoutWeight(1)
   253|          .scrollBar(BarState.Off)
   254|        }
   255|
   256|        // === 底部操作栏 ===
   257|        Row() {
   258|          Button() {
   259|            Text('📊').fontSize(20)
   260|          }
   261|          .backgroundColor(Color.Transparent)
   262|          .onClick(() => this.goToStats())
   263|          Button() {
   264|            Text('+')
   265|              .fontSize(28)
   266|              .fontWeight(FontWeight.Lighter)
   267|          }
   268|          .width(56)
   269|          .height(56)
   270|          .borderRadius(28)
   271|          .backgroundColor('#e74c3c')
   272|          .fontColor(Color.White)
   273|          .shadow({ radius: 8, color: '#e74c3c40' })
   274|          .onClick(() => this.goToRecord())
   275|          Button() {
   276|            Text('⚙️').fontSize(20)
   277|          }
   278|          .backgroundColor(Color.Transparent)
   279|          .onClick(() => router.pushUrl({ url: 'pages/SettingsPage' }))
   280|        }
   281|        .width('100%')
   282|        .height(64)
   283|        .justifyContent(FlexAlign.SpaceAround)
   284|        .backgroundColor('#fff')
   285|      }
   286|      .width('100%')
   287|      .height('100%')
   288|      .backgroundColor('#f5f5f5')
   289|
   290|      // === 登录弹窗 ===
   291|      if (this.showLoginDialog) {
   292|        Column() {
   293|          // 遮罩
   294|        }
   295|        .width('100%').height('100%')
   296|        .backgroundColor('#00000040')
   297|        .onClick(() => this.cancelLogin())
   298|
   299|        Column() {
   300|          Column() {
   301|            Row() {
   302|              Text(this.loginIsRegister ? '📝 注册' : '🔐 登录').fontSize(18).fontWeight(FontWeight.Bold)
   303|              Blank()
   304|              Text('✕').fontSize(20).fontColor('#999').onClick(() => this.cancelLogin())
   305|            }
   306|            .width('100%')
   307|            .margin({ bottom: 16 })
   308|
   309|            // 华为一键登录
   310|            Button() {
   311|              Row() {
   312|                Text('🔑').fontSize(18).margin({ right: 6 })
   313|                Text('华为帐号一键登录').fontSize(15).fontColor('#fff')
   314|              }
   315|            }
   316|            .width('100%').height(44)
   317|            .backgroundColor('#cf0a2c').borderRadius(8)
   318|            .enabled(this.loginAgreed)
   319|            .onClick(() => this.doHuaweiLogin())
   320|            .margin({ bottom: 16 })
   321|
   322|            // 分割
   323|            Row() {
   324|              Divider().width('25%')
   325|              Text(' 或使用密码 ').fontSize(12).fontColor('#ccc')
   326|              Divider().width('25%')
   327|            }
   328|            .width('100%')
   329|            .margin({ bottom: 12 })
   330|
   331|            // 表单
   332|            TextInput({ placeholder: '用户名', text: this.loginUsername })
   333|              .onChange((v: string) => this.loginUsername = v)
   334|              .width('100%').height(44).margin({ bottom: 12 })
   335|              .borderRadius(8).backgroundColor('#f5f5f5')
   336|
   337|            TextInput({ placeholder: '密码', text: this.loginPassword })
   338|              .type(InputType.Password)
   339|              .onChange((v: string) => this.loginPassword = v)
   340|              .width('100%').height(44).margin({ bottom: 12 })
   341|              .borderRadius(8).backgroundColor('#f5f5f5')
   342|
   343|            if (this.loginError) {
   344|              Text(this.loginError).fontSize(12).fontColor('#e74c3c').margin({ bottom: 8 })
   345|            }
   346|
   347|            Button(this.loginIsRegister ? '注册' : '登录')
   348|              .width('100%').height(44).fontSize(15)
   349|              .backgroundColor('#27ae60').borderRadius(8)
   350|              .enabled(this.loginAgreed && !this.loginLoading)
   351|              .onClick(() => this.doLogin())
   352|
   353|            // 切换登录/注册
   354|            Row() {
   355|              Text(this.loginIsRegister ? '已有账号？' : '没有账号？').fontSize(12).fontColor('#999')
   356|              Text(this.loginIsRegister ? '去登录' : '去注册').fontSize(12).fontColor('#27ae60')
   357|                .onClick(() => { this.loginIsRegister = !this.loginIsRegister; this.loginError = '' })
   358|            }
   359|            .width('100%').justifyContent(FlexAlign.Center)
   360|            .margin({ top: 12 })
   361|
   362|            // === 隐私条款（可勾选）===
   363|            Row() {
   364|              Text(this.loginAgreed ? '☑' : '☐').fontSize(16).fontColor('#666')
   365|                .onClick(() => this.toggleAgreed())
   366|              Text(' 已阅读并同意 ').fontSize(11).fontColor('#999')
   367|                .onClick(() => this.toggleAgreed())
   368|              Text('隐私政策').fontSize(11).fontColor('#2d6be0')
   369|                .decoration({ type: TextDecorationType.Underline })
   370|                .onClick(() => { this.showPrivacyContent = 'privacy' })
   371|              Text(' 和 ').fontSize(11).fontColor('#999')
   372|              Text('用户条款').fontSize(11).fontColor('#2d6be0')
   373|                .decoration({ type: TextDecorationType.Underline })
   374|                .onClick(() => { this.showPrivacyContent = 'terms' })
   375|            }
   376|            .width('100%').justifyContent(FlexAlign.Center)
   377|            .margin({ top: 12 })
   378|          }
   379|          .width('85%')
   380|          .padding(20)
   381|          .backgroundColor('#fff')
   382|          .borderRadius(16)
   383|      }
   384|      .width('100%')
   385|      .justifyContent(FlexAlign.Center)
   386|
   387|    // === 隐私条款/用户条款 悬浮嵌入内容（直接在 Stack 内）===
   448|    if (this.showPrivacyContent !== '') {
   449|      Column() {
   450|      }
   451|      .width('100%').height('100%')
   452|      .backgroundColor('#00000050')
   453|      .onClick(() => { this.showPrivacyContent = '' })
   454|
   455|      Column() {
   456|        Column() {
   457|          Row() {
   458|            Text(this.showPrivacyContent === 'privacy' ? '📄 隐私政策' : '📄 用户条款')
   459|              .fontSize(17).fontWeight(FontWeight.Bold).layoutWeight(1)
   460|            Text('✕').fontSize(20).fontColor('#999')
   461|              .onClick(() => { this.showPrivacyContent = '' })
   462|          }
   463|          .width('100%')
   464|          .margin({ bottom: 12 })
   465|
   466|          Scroll() {
   467|            Column() {
   468|              if (this.showPrivacyContent === 'privacy') {
   469|                PolicySection({ title: '1. 信息收集', content: '本应用仅收集您主动提供的信息：\n• 用户名和密码（加密存储，仅用于登录验证）\n• 您录入的交易记录（金额、品类、备注等）\n• 麦克风权限（仅用于语音记账功能，需您主动触发）\n\n我们不会收集您的设备标识、位置、通讯录或其他敏感信息。' })
   470|                PolicySection({ title: '2. 信息使用', content: '您的所有数据仅存储在设备本地数据库中。我们不向任何第三方传输您的数据。语音识别通过您指定的 AI 接口处理，不会用于模型训练。' })
   471|                PolicySection({ title: '3. 信息存储', content: '数据存储在设备本地 SQLite 数据库中。删除应用或清除数据将永久删除所有记录。建议您定期通过设置页的"数据导出"功能备份数据。' })
   472|                PolicySection({ title: '4. 第三方服务', content: '语音识别功能可能调用第三方 AI 接口。这些接口仅接收您上传的语音数据，不会获取您的账户信息或其他数据。' })
   473|                PolicySection({ title: '5. 用户权利', content: '您可以随时：\n• 在设置中导出您的全部数据\n• 删除单条或全部交易记录\n• 注销账号（删除所有数据）\n• 撤回麦克风权限授权' })
   474|                PolicySection({ title: '6. 联系方式', content: '如有任何隐私相关问题，请通过以下方式联系我们：\n邮箱：support@ct256.cn' })
   475|              } else {
   476|                PolicySection({ title: '1. 服务说明', content: '本应用（"快记交易"）提供个人记账及 AI 语音记账功能。您使用本应用即表示同意本条款。' })
   477|                PolicySection({ title: '2. 用户责任', content: '• 您对录入数据的准确性和合法性负责\n• 不得利用本应用从事违法违规活动\n• 应妥善保管账号密码，因密码泄露导致的损失由您自行承担' })
   478|                PolicySection({ title: '3. 免责声明', content: '• 本应用按"现状"提供服务，不保证服务不会中断\n• AI 语音识别结果仅供参考，不构成财务建议\n• 因不可抗力导致的数据丢失，开发者不承担责任' })
   479|                PolicySection({ title: '4. 知识产权', content: '本应用的所有权利（包括但不限于软件著作权、商标权）归开发者所有。未经许可，不得复制、修改、分发本应用。' })
   480|                PolicySection({ title: '5. 条款变更', content: '我们可能会不时更新本条款。重大变更将通过应用内通知告知您。继续使用即表示接受变更后的条款。' })
   481|                PolicySection({ title: '6. 联系我们', content: '如有任何问题，请发送邮件至：\nsupport@ct256.cn' })
   482|              }
   483|            }
   484|            .width('100%')
   485|            .padding({ bottom: 8 })
   486|          }
   487|          .layoutWeight(1)
   488|          .scrollBar(BarState.Off)
   489|        }
   490|        .width('85%')
   491|        .maxHeight('70%')
   492|        .padding(20)
   493|        .backgroundColor('#fff')
   494|        .borderRadius(16)
   495|      }
   496|      .width('100%')
   497|      .justifyContent(FlexAlign.Center)
   498|    }
   499|  }
   500|
   501|